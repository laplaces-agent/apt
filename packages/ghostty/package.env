# Ghostty — https://ghostty.org/
# UPSTREAM_VERSION / UPSTREAM_SHA256 / ZIG_VERSION are bumped automatically by
# .github/workflows/check-upstream.yml. DEBIAN_REVISION is not.
UPSTREAM_VERSION=1.4.0
UPSTREAM_SHA256=cb188ac6c3a8278d5fd7bfef15d8c017104c87f638b5560eb38024a71ae0f005

# Ghostty builds against exactly one Zig release — this is minimum_zig_version
# from its build.zig.zon, not whatever Zig is current. Unrelated to packages/zig.
ZIG_VERSION=0.17.0
ZIG_SHA256=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026

# Bump when the packaging changes without an upstream release. An upstream bump
# resets this to 1, which still outranks any revision of an older version. The
# starting value was picked to outrank the third-party package it replaces —
# see README, "Version numbering".
DEBIAN_REVISION=1
