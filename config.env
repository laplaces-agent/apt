# Repository-wide settings, sourced by every script.
#
# DISTRIBUTION and COMPONENT are baked into the sources.list line on every
# client, so pick them once and leave them alone. DISTRIBUTION must match the
# container image the build workflows run in (see .github/workflows/); the
# build scripts assert this rather than trusting it.
DISTRIBUTION=sid
COMPONENT=main
ARCHITECTURE=amd64

# Served on a custom domain rather than the github.io one, so the repository
# can move between GitHub accounts without every client needing a new
# sources.list. PAGES_DOMAIN is written to the CNAME file on each publish.
PAGES_DOMAIN=apt.xeyes.org
PAGES_URL="https://$PAGES_DOMAIN"

# Basename for the keyring and sources.list files on the client side, matching
# the convention already used for other third-party repositories here.
KEYRING_NAME=apt.xeyes.org

MAINTAINER="laplaces-agent <claude@xeyes.org>"
ORIGIN="xeyes.org"
LABEL="xeyes.org apt repository"
